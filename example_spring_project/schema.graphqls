type Query {
    users(first: Int, filter: String): [User!]!
    user(id: ID!): User
    searchUsers(query: String!): [User!]!
}

type Mutation {
    createUser(input: CreateUserInput!): User!
    updateUser(id: ID!, input: UpdateUserInput!): User!
    deleteUser(id: ID!): Boolean!
}

type Subscription {
    userUpdates(userId: ID): User!
    userCreated: User!
}

type User {
    id: ID!
    username: String!
    email: String!
    firstName: String!
    lastName: String!
    department: String
    active: Boolean!
    createdAt: String!
    updatedAt: String
}

input CreateUserInput {
    username: String!
    email: String!
    firstName: String!
    lastName: String!
    password: String!
    department: String
}

input UpdateUserInput {
    username: String
    email: String
    firstName: String
    lastName: String
    department: String
    active: Boolean
}

enum UserRole {
    ADMIN
    USER
    MODERATOR
}

type UserConnection {
    edges: [UserEdge!]!
    pageInfo: PageInfo!
}

type UserEdge {
    node: User!
    cursor: String!
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}